FROM node:24-bookworm-slim
ENV NODE_ENV=production PUPPETEER_SKIP_DOWNLOAD=true WHATSAPP_DATA_PATH=/app/.runtime/whatsapp PORT=3338
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY lib ./lib
COPY scripts ./scripts
COPY public ./public
RUN node scripts/sync-pwa-version.mjs && mkdir -p /app/.runtime/whatsapp && chown -R node:node /app
VOLUME ["/app/.runtime/whatsapp"]
USER node
EXPOSE 3338
CMD ["node", "scripts/serve.mjs"]
