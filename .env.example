# Copiar para .env.local SOMENTE no seu computador. Nunca versionar as chaves reais.
# Configure as mesmas variaveis em Production no projeto Vercel.
APP_ORIGIN=https://SEU-PROJETO.vercel.app
# String PostgreSQL do Supabase. Preferir pooler de transacoes porta 6543 para API.
# Use credencial de backend com acesso ao schema mensageria. Nunca anon key.
# Sem DATABASE_URL, o worker e o painel local usam o volume WHATSAPP_DATA_PATH.
# A API na Vercel continua exigindo PostgreSQL.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:6543/postgres
# Se a cadeia do certificado exigir CA propria, obter no painel Supabase.
DATABASE_CA_CERT=
# Gerar com npm run secrets. Tres valores DIFERENTES.
ADMIN_TOKEN=
INTEGRATION_TOKEN=
SESSION_ENCRYPTION_KEY=
# Retorno de agua: HTTPS do Super App e segredo exclusivo igual ao backend do Super App.
SUPERAPP_API_ORIGIN=
WHATSAPP_WATER_CALLBACK_TOKEN=
# Compras: habilitar explicitamente e autorizar cada pessoa no painel. O numero pinado identifica a conta conectada/readiness.
WHATSAPP_PURCHASE_ENABLED=false
WHATSAPP_PURCHASE_OWNER_PHONE=
WHATSAPP_PURCHASE_CALLBACK_TOKEN=
# Exclusiva do worker; nunca publicar a chave Groq no painel/navegador.
GROQ_API_KEY=
# O container define esses caminhos; nao configurar caminhos Windows na Vercel.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# WHATSAPP_DATA_PATH=/app/.runtime/whatsapp
